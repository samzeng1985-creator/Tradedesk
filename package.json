{
  "name": "trade-desk-local",
  "private": true,
  "version": "0.26.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "test": "node --experimental-strip-types --test tests/businessOverview.test.mjs tests/decimalInput.test.mjs",
    "qa:release": "python scripts/run-release-qa.py",
    "prepare:runtime:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-typst-runtime.ps1",
    "release:windows": "pnpm prepare:runtime:windows && tauri build --bundles nsis --ci",
    "preview": "vite preview --configLoader runner",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
